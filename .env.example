# Copy to .env.local and fill in. Never commit real values.
AUTH_SECRET=
AUTH_ATLASSIAN_ID=
AUTH_ATLASSIAN_SECRET=
JIRA_SITE_URL=https://surveymonkey.atlassian.net
# Owners who can always manage people, even if the user list is lost. Comma-separated. Keep at least two.
ADMIN_EMAILS=
# Starting list of creatives. Only used the first time the user list is created; manage people in the app after that.
CREATIVE_EMAILS=
# Created by `vercel blob create-store`; the private data store.
BLOB_READ_WRITE_TOKEN=
# "jira" turns on sign-in and real Jira data. Leave empty for the mock demo.
NEXT_PUBLIC_DATA_SOURCE=
# Google OAuth client (Web application) for My Day: calendar read + Google Tasks backup. See docs/google-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Figma access token (a dedicated Brand Creative Hub Figma account, file_content:read) so "choose frames" can list a file's frames and thumbnails.
# Without it, people add frame links by hand. The account must be able to open the files being submitted.
FIGMA_ACCESS_TOKEN=
